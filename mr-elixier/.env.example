# Kopiere diese Datei nach .env.local (lokal) bzw. trage die Werte bei Vercel
# unter Settings -> Environment Variables ein.

# Öffentliche Adresse des Shops (für Links in E-Mails & Stripe-Weiterleitungen)
NEXT_PUBLIC_SITE_URL=https://www.deine-domain.de

# Stripe (https://dashboard.stripe.com/apikeys). Ohne Schlüssel läuft der
# Checkout im Demo-Modus: Bestellungen werden simuliert, nichts wird berechnet.
STRIPE_SECRET_KEY=
# Webhook-Signatur (Dashboard -> Entwickler -> Webhooks -> Endpunkt
# https://<deine-domain>/api/stripe/webhook, Ereignisse:
# checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed)
STRIPE_WEBHOOK_SECRET=

# Optional: Bestell-E-Mail an den Inhaber über Resend (https://resend.com)
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
ORDER_FROM_EMAIL="Mr. Elixier Shop <shop@deine-domain.de>"
